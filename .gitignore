# ========================
# Python and machine learning
# ========================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.env

# Quality-tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# Heavy artifacts and models belong in MLflow/DVC + S3, not git
mlruns/
mlartifacts/
core_ml/artifacts*/
*.pth
*.pt
*.h5
*.pkl
